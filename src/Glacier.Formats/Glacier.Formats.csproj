<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Formats</PackageId>
    <Version>1.0.1</Version>
    <PackageReleaseNotes>v1.0.1: Hardened Glacier Compact Columnar IPC v1 framing, Parquet v1 RLE nullable definition levels, SnappyCodec ArrayPool/XOR optimization, canonical FastLanesBitUnpacker, and hardware Crc32c.</PackageReleaseNotes>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Pure C# .NET 10 Zero-Dependency Columnar Interchange Formats: Glacier Compact Columnar IPC v1 (Arrow-inspired columnar buffers with custom 16B header + 36B descriptor framing; not FlatBuffers wire-compatible), Parquet v1 reader/writer (Uncompressed/Snappy, PLAIN + RLE definition levels), FastLanesBitUnpacker, and hardware Crc32c.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Formats</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Formats.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>glacier;columnar;ipc;parquet;snappy;thrift;fastlanes;crc32c;simd;net10;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.Formats.Tests" />
    <InternalsVisibleTo Include="Glacier.Storage" />
  </ItemGroup>
</Project>
